---
const services = [
  {
    title: "UI/UX Design",
    description:
      "Investigación, wireframes, prototipado y diseño de interfaz para productos digitales.",
  },
  {
    title: "Diseño de producto",
    description:
      "Diseño de flujos y pantallas completas, del concepto a un sistema de diseño consistente.",
  },
  {
    title: "Branding",
    description:
      "Identidad visual: logo, paleta, tipografía y aplicaciones de marca.",
  },
];
---

<section id="servicios" class="section">
  <p class="eyebrow">Qué hago</p>
  <h2 class="text-4xl md:text-5xl mb-12">Servicios</h2>

  <div class="grid md:grid-cols-3 gap-6">
    {
      services.map((service) => (
        <div class="glass rounded-xl2 p-8 hover:border-primary/40 transition">
          <h3 class="font-display text-2xl normal-case tracking-normal mb-3">
            {service.title}
          </h3>
          <p class="text-muted leading-relaxed">{service.description}</p>
        </div>
      ))
    }
  </div>
</section>
