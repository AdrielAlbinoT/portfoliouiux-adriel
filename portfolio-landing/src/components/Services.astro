---
const services = [
  {
    title: "UI/UX Design",
    description:
      "He creado interfaces de usuario y experiencias digitales para aplicaciones móviles y webs. Desde web apps funcionales hasta landing pages atractivas, diseño cada interfaz pensando en usabilidad, estética y el usuario final.",
  },
  {
    title: "Editorial",
    description:
      "Diseño de brochures, manuales, revistas y material editorial de alto impacto. Creo layouts que comunican efectivamente tu mensaje mientras mantienen una estética profesional y coherente.",
  },
  {
    title: "Branding",
    description:
      "Creación de identidades de marca únicas y memorables. Desde logos icónicos hasta sistemas visuales completos, desarrollo la esencia visual de tu marca.",
  },
  {
    title: "Digital Design",
    description:
      "Diseño gráfico versátil para cualquier formato: flyers, banners, gráficos digitales y material listo para impresión. Cada pieza diseñada para captar atención y transmitir tu mensaje.",
  },
  {
    title: "Social Media",
    description:
      "Diseño de contenido gráfico para redes sociales e Instagram. Creo piezas visuales atractivas y optimizadas para YouTube, TikTok, Instagram y otras plataformas.",
  },
];
---

<section id="servicios" class="section">
  <p class="eyebrow">Qué hago</p>
  <h2 class="text-4xl md:text-5xl mb-12">Servicios</h2>

  <div class="relative">
    <!-- Carrusel con Scroll Snap -->
    <div
      class="services-carousel flex gap-6 overflow-x-auto scroll-smooth snap-x snap-mandatory pb-2"
      id="servicesCarousel"
    >
      {
        services.map((service) => (
          <div class="snap-center shrink-0 w-full md:w-[calc(50%-12px)] lg:w-[calc(33.333%-16px)]">
            <div class="glass rounded-xl2 p-8 hover:border-primary/40 transition h-full flex flex-col">
              <h3 class="font-display text-2xl normal-case tracking-normal mb-4 text-ink">
                {service.title}
              </h3>
              <p class="text-[#C5C5C5] leading-relaxed flex-grow">
                {service.description}
              </p>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Controles de navegación (solo en desktop) -->
    <div class="hidden md:flex gap-4 mt-8 justify-center">
      <button
        id="scrollPrev"
        class="p-3 rounded-full bg-primary text-white hover:brightness-110 transition"
        aria-label="Anterior"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M15 19l-7-7 7-7"
          ></path>
        </svg>
      </button>
      <button
        id="scrollNext"
        class="p-3 rounded-full bg-primary text-white hover:brightness-110 transition"
        aria-label="Siguiente"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M9 5l7 7-7 7"
          ></path>
        </svg>
      </button>
    </div>
  </div>
</section>

<style>
  .services-carousel {
    scrollbar-width: none;
  }

  .services-carousel::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  const carousel = document.getElementById("servicesCarousel");
  const scrollPrev = document.getElementById("scrollPrev");
  const scrollNext = document.getElementById("scrollNext");

  const scrollAmount = 400;
  let autoplayInterval: ReturnType<typeof setInterval> | null = null;
  let isUserInteracting = false;

  function startAutoplay() {
    if (autoplayInterval) clearInterval(autoplayInterval);
    autoplayInterval = setInterval(() => {
      carousel?.scrollBy({
        left: scrollAmount,
        behavior: "smooth",
      });
    }, 5000);
  }

  function stopAutoplay() {
    if (autoplayInterval) clearInterval(autoplayInterval);
    autoplayInterval = null;
  }

  function resumeAutoplayAfterDelay() {
    stopAutoplay();
    setTimeout(() => {
      startAutoplay();
    }, 2000);
  }

  scrollPrev?.addEventListener("click", () => {
    carousel?.scrollBy({
      left: -scrollAmount,
      behavior: "smooth",
    });
    resumeAutoplayAfterDelay();
  });

  scrollNext?.addEventListener("click", () => {
    carousel?.scrollBy({
      left: scrollAmount,
      behavior: "smooth",
    });
    resumeAutoplayAfterDelay();
  });

  carousel?.addEventListener("mousedown", () => {
    stopAutoplay();
    isUserInteracting = true;
  });

  carousel?.addEventListener("mouseup", () => {
    isUserInteracting = false;
    resumeAutoplayAfterDelay();
  });

  carousel?.addEventListener("touchstart", () => {
    stopAutoplay();
    isUserInteracting = true;
  });

  carousel?.addEventListener("touchend", () => {
    isUserInteracting = false;
    resumeAutoplayAfterDelay();
  });

  startAutoplay();
</script>
