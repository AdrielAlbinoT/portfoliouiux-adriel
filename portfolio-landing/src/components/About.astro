---
// TODO: reemplaza con tu experiencia real
const experience = [
  {
    period: "2024 — Presente",
    role: "Diseñadora UI/UX",
    company: "Nombre de la empresa",
    description: "Diseño de producto digital de punta a punta: research, wireframes, UI y testing con usuarios.",
  },
  {
    period: "2022 — 2024",
    role: "Diseñadora Gráfica / Digital",
    company: "Nombre de la empresa",
    description: "Piezas digitales, identidad de marca y diseño editorial para distintos clientes.",
  },
  {
    period: "2021 — 2022",
    role: "Diseñadora Junior",
    company: "Nombre de la empresa",
    description: "Apoyo en proyectos de branding y diseño para redes sociales.",
  },
];
---

<section id="sobre-mi" class="section">
  <div class="grid md:grid-cols-2 gap-16">
    <div>
      <p class="eyebrow">Sobre mí</p>
      <h2 class="text-4xl md:text-5xl mb-6 leading-[0.95]">
        Diseño con<br />intención
      </h2>
      <p class="text-muted leading-relaxed mb-6">
        <!-- TODO: reemplaza con tu historia real -->
        Soy diseñadora UI/UX enfocada en crear productos digitales claros y
        usables. Me interesa el proceso tanto como el resultado: entender el
        problema real antes de proponer una solución visual.
      </p>
      <p class="text-muted leading-relaxed">
        Trabajo con equipos de producto, marcas y negocios que necesitan
        traducir una idea en una experiencia digital sólida.
      </p>
    </div>

    <div class="relative pl-8 border-l border-line space-y-10">
      {
        experience.map((item) => (
          <div class="relative">
            <span class="absolute -left-[2.35rem] top-1 w-3 h-3 rounded-full bg-primary" />
            <p class="text-primary text-sm font-medium mb-1">{item.period}</p>
            <h3 class="font-display text-xl normal-case tracking-normal mb-1">
              {item.role}
            </h3>
            <p class="text-muted text-sm mb-2">{item.company}</p>
            <p class="text-muted text-sm leading-relaxed">{item.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
